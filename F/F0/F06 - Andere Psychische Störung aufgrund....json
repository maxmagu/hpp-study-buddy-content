    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Sekundäre psychische Störungen "
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Organische psychische Störungen zweiten Ranges"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Definition"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Durch zerebrale (primär das Gehirn betreffend) oder systemische (sekundär das Gehirn betreffend) Erkrankungen verursacht"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Das psychopathologische Bild ähnelt sehr den nichtorganischen psychischen Störungen"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Das klinische Bild unterscheidet sich i.d.R. nicht von den primären psychischen Erkrankungen"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Geht i.d.R. einher mit Leitsymptomen organischer psychischer Störungen wie Demenz und Delir."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Diagnose"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Nachweis einer zerebralen Erkrankung, Verletzung oder Funktionsstörung oder einer systemischen körperlichen Erkrankung, von dem bekannt ist, dass es mit einem der aufgeführten Syndrome einhergehen kann"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Zeitlicher Zusammenhang zwischen der Entwicklung der zugrunde liegenden Krankheit und dem Auftreten des psychischen Syndroms"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Rückbildung der psychischen Störung nach Rückbildung oder Besserung der organischen Ursache"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Kein überzeugender Beleg für eine andere Verursachung des psychischen Syndroms (z.B. belastete Familiengeschichte oder belastende Ereignisse)"
                }
              ]
            }
          ]
        }
      ]
    },
