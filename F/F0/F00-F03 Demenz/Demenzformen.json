              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Ablagerung von Amyloid-Plaques; Hirnatrophie; Veränderung der Neurofibrillen"
