        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Häufigste Demenzform; betrifft 5% der über 65-Jährigen; ca. 1 Mio. Menschen in D."
