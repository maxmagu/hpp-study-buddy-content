{
  "type": "doc",
  "content": [
    {
      "type": "heading",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "type": "text",
          "text": "Demenzformen"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Alzheimer-Demenz [F00]"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fortschreitende, unheilbare degenerative Erkrankung des Gehirns"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Unterformen: Früher Beginn (<65J) vs. später Beginn (kaum Unterschiede im Verlauf)"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Lebenserwartung 5-8 Jahre; die letzten 2 sehr eingeschränkt"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Epidemiologie: Häufigste Demenzform; betrifft 5% der über 65-Jährigen; ca. 1 Mio. Menschen in D."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "type": "text",
          "text": "Ursache"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Amyloid-Plaques:"
                },
                {
                  "type": "text",
                  "text": " Eiweißklumpen, die sich "
                },
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "außerhalb"
                },
                {
                  "type": "text",
                  "text": " der Nervenzellen ablagern und die Kommunikation stören."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Tau-Fibrillen:"
                },
                {
                  "type": "text",
                  "text": " Verformte Eiweißfäden "
                },
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "innerhalb"
                },
                {
                  "type": "text",
                  "text": " der Zellen, die deren Nährstoffversorgung unterbrechen."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Zelltod:"
                },
                {
                  "type": "text",
                  "text": " Durch diese Prozesse sterben Nervenzellen und ihre Verbindungen (Synapsen) massenhaft ab."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Hirnschrumpfung:"
                },
                {
                  "type": "text",
                  "text": " Das Gehirngewebe baut sich sichtbar ab, was die geistigen Fähigkeiten einschränkt."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Fakt:"
                },
                {
                  "type": "text",
                  "text": " Warum diese Ablagerungen bei manchen Menschen entstehen und bei anderen nicht, ist wissenschaftlich noch nicht vollständig geklärt."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Vaskuläre Demenz [F01]"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Ursache:"
                },
                {
                  "type": "text",
                  "text": " Durchblutungsstörungen im Gehirn, oft durch kleine Schlaganfälle oder verengte Gefäße."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Symptome:"
                },
                {
                  "type": "text",
                  "text": " Verlangsamtes Denken, Konzentrationsprobleme und oft auch körperliche Gangunsicherheit."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Verlauf:"
                },
                {
                  "type": "text",
                  "text": " Häufig stufenweise Verschlechterung (nach jedem Gefäßereignis) statt eines schleichenden Abbaus."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Risikofaktoren:"
                },
                {
                  "type": "text",
                  "text": " Bluthochdruck, Diabetes, Rauchen und hoher Cholesterinspiegel fördern die Entstehung."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Therapie:"
                },
                {
                  "type": "text",
                  "text": " Fokus auf der Behandlung der Grunderkrankungen, um weitere Gefäßschäden zu verhindern."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Lebenserwartung 4 Jahre nach Diagnosenstellung"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Frontotemporale Demenz (Pick-Krankheit; Morbus Pick)"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Nervenzelluntergang primär im Stirnhirn (Frontallappen) und Schläfenlappen. "
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Pick-Körperchen nachweisbar."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Epidemiologie:"
                },
                {
                  "type": "text",
                  "text": " Selten; vorwiegend Männer unter 65 Jahren"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "type": "text",
          "text": "Symptome"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Frühe Veränderung der Persönlichkeit und des Sozialverhaltens (Distanzlosigkeit, Aggressivität)."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Häufige Probleme bei der Wortfindung oder völliger Sprachverlust im Verlauf."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Gedächtnis "
                },
                {
                  "type": "text",
                  "text": "bleibt im Gegensatz zu Alzheimer in der Anfangsphase meist noch lange erhalten."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Lewy-Körperchen-Demenz"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Ablagerungen:"
                },
                {
                  "type": "text",
                  "text": " Krankhafte Eiweißklumpen (Alpha-Synuclein) in den Nervenzellen."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Mischform:"
                },
                {
                  "type": "text",
                  "text": " Vereint biologische Merkmale von Alzheimer und Parkinson."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Zweithäufigste Form:"
                },
                {
                  "type": "text",
                  "text": " Nach Alzheimer die häufigste neurodegenerative Demenzart."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Betroffene:"
                },
                {
                  "type": "text",
                  "text": " Tritt meist im höheren Lebensalter (ab 65 Jahren) auf."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Diagnose:"
                },
                {
                  "type": "text",
                  "text": " Schwierig abzugrenzen, da sie anderen Demenzformen stark ähnelt."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "type": "text",
          "text": "Symptome"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Halluzinationen:"
                },
                {
                  "type": "text",
                  "text": " Detailreiche optische Täuschungen, oft schon im Frühstadium."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Schwankungen:"
                },
                {
                  "type": "text",
                  "text": " Geistige Wachheit und Konzentration variieren massiv über den Tag."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Motorik:"
                },
                {
                  "type": "text",
                  "text": " Parkinson-ähnliche Beschwerden wie Steifheit, Zittern oder Sturzneigung."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Schlafstörungen:"
                },
                {
                  "type": "text",
                  "text": " Ausagieren von Träumen durch heftige Bewegungen (REM-Schlaf-Störung)."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "text": "Empfindlichkeit:"
                },
                {
                  "type": "text",
                  "text": " Extreme (teils gefährliche) Reaktion auf Neuroleptika (Beruhigungsmittel)."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
