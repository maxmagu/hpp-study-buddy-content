      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Wie gut können Sie sich Termine oder Namen im Vergleich zu früher merken?"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Fällt Ihnen manchmal ein Wort im Gespräch oder ein Begriff nichtmehr ein?"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Haben Sie in letzter Zeit Schwierigkeiten gehabt, den Herd oder die Kaffeemaschine zu bedienen?"
