            }
          ],
          "text": "Charakteristikum "
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ],
                  "text": "Symptome lassen sich kaum von psychogenen (nicht-organischen) Störungen unterscheiden."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ],
                  "text": "Auffälligkeiten liegen in Wahrnehmung, Denkinhalten, Stimmung, Persönlichkeit"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Bewusstseinsklarheit und intakte Kognition (oder nur leicht betroffen)"
