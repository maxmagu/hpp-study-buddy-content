            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ],
                  "text": "Verwechslung mit psychogenen Störungen unwahrscheinlich."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Störungen des Sensoriums (Bewusstsein, Aufmerksamkeit) und/oder der kognitiven Funktionen (Gedächtnis, Lernen, Intellekt, Orientierung)."
                }
              ]
            }
          ]
        }
      ]
    },
