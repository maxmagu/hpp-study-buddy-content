              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Diagnose einer organischen psychischen Störung erfordert Nachweis einer körperlichen Ursache"
                }
              ]
